# ==========================================
# VoiceNexus AI — Environment Variables
# ==========================================
# All values must remain blank in .env.example.
# Copy to .env.local for local development.
# ==========================================

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_VOICE_GATEWAY_URL=http://localhost:8080
NEXT_PUBLIC_VOICE_GATEWAY_WS_URL=ws://localhost:8080

# Supabase Public (Client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Server-Only (Privileged)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Voice Gateway Server-Only Secret
VOICE_GATEWAY_SECRET=

# Gnani AI (Server-Only)
GNANI_API_KEY=
GNANI_PRISMA_STT_URL=https://api.vachana.ai/stt/v3
GNANI_PRISMA_WS_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_TIMBRE_TTS_URL=https://api.vachana.ai/api/v1/tts/inference
GNANI_TIMBRE_WS_URL=wss://api.vachana.ai/api/v1/tts
GNANI_VOICE_CLONE_URL=https://api.vachana.ai/api/v1/tts/voice-clone/embeddings

# LLM Providers (Server-Only)
GEMINI_API_KEY=
GROQ_API_KEY=

# Twilio Telephony (Server-Only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_APP_SID=

# Production Owner Credential Autofill (Server-Only)
OWNER_CREDENTIAL_FILL_ENABLED=
OWNER_CREDENTIAL_FILL_KEY=
DEV_COMPANY_EMAIL=
DEV_COMPANY_PASSWORD=

